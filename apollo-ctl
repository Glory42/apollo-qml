#!/bin/sh
# Usage: apollo-ctl <target> <function> [args], e.g. apollo-ctl pill toggle wifi (works from any directory)
#
# Quickshell identifies an instance by the exact config path it was launched with, so a shell
# started through a symlinked config dir (~/.config/quickshell) doesn't match the resolved repo
# path. Try the path as invoked, the resolved path, then the default config, and use the first
# one that has a running instance.
logical=$(cd "$(dirname "$0")" && pwd)
resolved=$(dirname "$(readlink -f "$0")")

for dir in "$logical" "$resolved"; do
    if quickshell list -j -p "$dir/shell.qml" 2>/dev/null | grep -q '"id"'; then
        exec quickshell -p "$dir/shell.qml" ipc call "$@"
    fi
done

exec quickshell ipc call "$@"
